# ============================================================
# StyleSnap AI — Environment Variables
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
MOBILE_URL=exp://localhost:8081

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://stylesnap:password@localhost:5432/stylesnap_db"
DATABASE_SHADOW_URL="postgresql://stylesnap:password@localhost:5432/stylesnap_shadow"

# ── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_TLS=false

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# ── AI APIs ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=
REPLICATE_API_TOKEN=r8_...
STABILITY_API_KEY=sk-...
FASHN_API_KEY=                    # Virtual try-on
REMOVEBG_API_KEY=

# ── AWS ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=stylesnap-media
AWS_CLOUDFRONT_URL=https://cdn.stylesnap.ai

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_VIP_PRICE_ID=price_...

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="StyleSnap AI <noreply@stylesnap.ai>"

# ── Analytics ───────────────────────────────────────────────
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com
MIXPANEL_TOKEN=

# ── Public (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Supabase (optional) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
